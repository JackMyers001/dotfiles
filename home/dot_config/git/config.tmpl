[branch]
	# Sort branches by newest commit first
	sort = -committerdate

[column]
	# Display `git branch` output in columns
	ui = auto

[commit]
	# Show diff in commit message editor
	verbose = true

[diff]
	# Better diff output
	algorithm = histogram

	# Highlight moved vs added code in `git diff`
	colorMoved = plain

	# Use i/ (index), w/ (working), c/ (commit) prefixes instead of a/b/
	mnemonicPrefix = true

	# Detect renamed (moved) files
	renames = true

[fetch]
	# Fetch all branches and tags, removing any stale references
	all = true
	prune = true
	pruneTags = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f

[help]
	# Suggest fixes for mistyped commands
	autocorrect = prompt

[merge]
	# Include the common ancestor in conflict markers
	conflictStyle = zdiff3

	tool = smerge

[mergetool "smerge"]
	cmd = smerge mergetool "$BASE" "$LOCAL" "$REMOTE" -o "$MERGED"
	trustExitCode = true

[pull]
	# Rebase instead of merge when pulling
	rebase = true

[push]
	# Use same branch name on remote
	default = simple

	# Auto-setup remote tracking for new branches
	autoSetupRemote = true

	# Include tags when pushing
	followTags = true

	# Make `--force-with-lease` also check the remote branch was fetched
	useForceIfIncludes = true

[rebase]
	# Auto-squash fixup commits
	autoSquash = true

	# Auto-stash before rebasing
	autoStash = true

	# Update branches that depend on rebased branch
	updateRefs = true

[rerere]
	# Remember rebase conflict resolutions
	enabled = true

	# Auto-apply remembered resolutions
	autoupdate = true

[tag]
	# Sort tags by version number
	sort = version:refname

[user]
	name = Jack Myers
	email = {{ .email }}

{{- if lookPath "delta" }}
[core]
	pager = delta

[delta]
	# Use n and N to move between diff sections (doesn't work with `moor` PAGER)
	navigate = true

	# Show old and new content across two panes
	side-by-side = true

	syntax-theme = Dracula

[interactive]
	# Highlight hunks with delta in `git add -p` etc.
	diffFilter = delta --color-only
{{- end }}
