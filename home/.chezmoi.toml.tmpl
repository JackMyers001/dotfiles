{{- /* Platform detection (combines OS and distro into a single string like `linux-debian`) */ -}}
{{- $platformId := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $platformId = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- $isWsl := and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}

{{- /* SSH agent choices */ -}}
{{- $sshAgentChoices := list "none" -}}

{{- if eq .chezmoi.os "linux" -}}
{{-   $sshAgentChoices = append $sshAgentChoices "bitwarden-flatpak" -}}
{{-   $sshAgentChoices = append $sshAgentChoices "bitwarden-standalone" -}}
{{-   $sshAgentChoices = append $sshAgentChoices "ssh-user-agent" -}}
{{- end -}}

{{- if eq .chezmoi.os "darwin" -}}
{{-   $sshAgentChoices = append $sshAgentChoices "bitwarden-macos" -}}
{{-   $sshAgentChoices = append $sshAgentChoices "secretive" -}}
{{- end -}}

{{- if $isWsl -}}
{{-   $sshAgentChoices = append $sshAgentChoices "wsl2-ssh-agent" -}}
{{- end -}}

{{- /* User prompts */ -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $sshAgent := promptChoiceOnce . "sshAgent" "What SSH agent do you want to use" $sshAgentChoices -}}

{{- /* Derived values */ -}}
{{- $sshAuthSock := "" -}}
{{- if eq $sshAgent "bitwarden-flatpak" -}}
{{-   $sshAuthSock = "$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock" -}}
{{- else if eq $sshAgent "bitwarden-macos" -}}
{{-   $sshAuthSock = "$HOME/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock" -}}
{{- else if eq $sshAgent "bitwarden-standalone" -}}
{{-   $sshAuthSock = "$HOME/.bitwarden-ssh-agent.sock" -}}
{{- else if eq $sshAgent "secretive" -}}
{{-   $sshAuthSock = "$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh" -}}
{{- else if eq $sshAgent "ssh-user-agent" -}}
{{-   $sshAuthSock = "$XDG_RUNTIME_DIR/socket-agent.socket" -}}
{{- else if eq $sshAgent "wsl2-ssh-agent" -}}
{{-   $sshAuthSock = "$HOME/.ssh/wsl2-ssh-agent.sock" -}}
{{- end -}}

[data]
    email = {{ $email | quote }}
    isWsl = {{ $isWsl }}
    platformId = {{ $platformId | quote }}
    sshAgent = {{ $sshAgent | quote }}
    sshAuthSock = {{ $sshAuthSock | quote }}
